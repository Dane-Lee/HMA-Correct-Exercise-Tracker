{
  ".print-oa-note": "background:#fff8e8;border:1px solid #e65100;border-radius:4px;padding:6px 10px;margin-bottom:10px;font-size:14px;color:#bf360c;font-weight:700",
  ".print-preview": "background:#fff;border:1px solid #ccc;padding:20px;max-width:760px;margin:0 auto;font-family:'Bitter',Georgia,serif",
  ".print-header": "display:grid;grid-template-columns:1fr auto 1fr;align-items:center;margin-bottom:16px;padding-bottom:12px;border-bottom:3px solid #e4002b",
  ".print-logo-box": "background:#1a1a1a;color:#fff;padding:6px 14px;font-weight:900;font-size:28px;letter-spacing:2px",
  ".print-logo-sub": "font-size:14px;color:#555;text-align:center;margin-top:2px",
  ".print-title": "font-size:35px;font-weight:700;text-transform:uppercase;color:#e4002b;letter-spacing:1px;font-family:'Barlow Condensed',sans-serif",
  ".print-running-header": "display:none",
  ".print-emp-info": "display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:14px;font-size:19px",
  ".print-info-item": "border-bottom:1px solid #333;padding-bottom:2px",
  ".print-info-label": "font-size:15px;color:#555;text-transform:uppercase;font-weight:700;font-family:'Barlow',Arial,sans-serif",
  ".print-exercises": "display:grid;grid-template-columns:repeat(3,1fr);gap:10px",
  ".ex-type-badge": "display:inline-block;font-size:11px;font-weight:700;padding:1px 6px;border-radius:3px;text-transform:uppercase;letter-spacing:.3px;vertical-align:middle;margin-left:4px",
  ".ex-type-flexibility": "background:#e3f2fd;color:#1565c0",
  ".ex-type-mobility": "background:#fff3e0;color:#e65100",
  ".ex-type-static-stabilization": "background:#e8f5e9;color:#2e7d32",
  ".ex-type-dynamic-stabilization": "background:#e0f2f1;color:#00695c",
  ".ex-type-strength": "background:#f3e5f5;color:#6a1b9a",
  ".print-section": "margin-bottom:16px;break-inside:avoid;page-break-inside:avoid",
  ".print-section-header": "background:#000;color:#fff;padding:6px 12px;font-size:15px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;border-left:4px solid #e4002b;margin-bottom:8px;display:flex;align-items:center;justify-content:space-between;font-family:'Barlow Condensed',sans-serif;break-after:avoid;page-break-after:avoid",
  ".print-section-score": "font-size:13px;font-weight:400;opacity:.75;letter-spacing:0",
  ".print-ex-card": "border:1px solid #ccc;border-radius:6px;padding:10px;font-size:18px;border-top:3px solid #e4002b;break-inside:avoid;page-break-inside:avoid",
  ".print-ex-img": "width:100%;height:120px;object-fit:contain;border-radius:4px;margin-bottom:6px;border:1px solid #eee;background:#f9f9f9",
  ".print-ex-name": "font-weight:700;font-size:18px;text-transform:uppercase;color:#e4002b;margin-bottom:4px;letter-spacing:.3px;font-family:'Barlow Condensed',sans-serif",
  ".print-ex-inst": "font-size:15px;color:#333;line-height:1.4",
  ".print-ex-sets": "background:#f5f5f5;border-top:1px solid #ddd;margin-top:6px;padding:4px 6px;font-size:15px;font-family:'Barlow',Arial,sans-serif",
  ".print-footer": "margin-top:14px;font-size:14px;color:#777;text-align:center;border-top:1px solid #ddd;padding-top:6px",
  ".cal-grid": "display:flex;flex-wrap:wrap;justify-content:center;gap:12px;margin-bottom:12px",
  ".cal-day": "flex:0 0 calc((100% - 24px)/3);border:1px solid #ddd;border-radius:6px;border-top:3px solid #e4002b;break-inside:avoid;page-break-inside:avoid",
  ".cal-day-header": "background:#000;color:#fff;padding:6px 10px;font-size:15px;font-weight:700;display:flex;justify-content:space-between;align-items:center;font-family:'Barlow Condensed',sans-serif;text-transform:uppercase;letter-spacing:.5px",
  ".cal-day-time": "font-size:12px;font-weight:400;opacity:.75;letter-spacing:0",
  ".cal-day.over": "border-top-color:#e65100",
  ".cal-day.over .cal-day-header": "background:#7a2e00",
  ".cal-day-time.over": "opacity:1;color:#ffcc80;font-weight:700",
  ".cal-day-body": "padding:6px 8px",
  ".cal-ex-row": "display:flex;align-items:center;gap:6px;padding:3px 0;border-bottom:1px solid #f0f0f0;font-size:12px",
  ".cal-ex-row:last-child": "border-bottom:none",
  ".cal-ex-step": "font-size:10px;color:#aaa;min-width:14px;font-weight:700;flex-shrink:0",
  ".cal-ex-name": "flex:1;font-weight:500;font-size:13px",
  ".print-hyper-note": "background:#e8eeff;border:1px solid #1565c0;border-radius:4px;padding:6px 10px;margin-bottom:10px;font-size:14px;color:#1565c0;font-weight:700",
  ":root[data-theme=\"dark\"] .print-preview,:root[data-theme=\"dark\"] .print-preview *": "background:#fff!important;color:#222!important",
  ":root[data-theme=\"dark\"] .print-ex-name": "color:#e4002b!important",
  ":root[data-theme=\"dark\"] .print-info-label": "color:#555!important",
  ":root[data-theme=\"dark\"] .print-footer": "color:#777!important",
  "@media print": "@media print{\r\n  @page{margin:20mm 12mm 14mm}\r\n  body{background:#fff}\r\n  .no-print{display:none!important}\r\n  .header{display:none!important}\r\n  .tabs{display:none!important}\r\n  .print-preview{border:none;padding:10px}\r\n  .print-running-header{display:block;position:fixed;top:-13mm;left:0;right:0;text-align:center;font:700 12px 'Barlow Condensed',sans-serif;color:#444;letter-spacing:.5px}\r\n}"
}
